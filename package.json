{
  "name": "homebox-mcp",
  "version": "0.2.1",
  "description": "Remote HTTP/HTTPS MCP server for one Homebox instance, many collections and users.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "bin": {
    "homebox-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "check": "npm run build && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
